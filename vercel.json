{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/room/:roomId", "destination": "/api/og" },
    { "source": "/room/:roomId/:slug", "destination": "/api/og" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
